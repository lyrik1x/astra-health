# Copiar a .env (no se versiona). Sin secretos.
PORT=3000
# SQLite dentro de apps/api (relativo a apps/api; excluido por .gitignore)
DATABASE_URL="file:./dev.db"
# Orígenes permitidos por CORS, separados por coma: Vite dev y vite preview
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Límite del cuerpo JSON de las peticiones (formato de body-parser: b, kb o mb)
BODY_LIMIT=1mb
# Enables POST /api/demo/reset. Keep disabled outside demo rehearsal.
DEMO_RESET_ENABLED=true

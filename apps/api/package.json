{
  "name": "@astra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "prisma generate && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "db:generate": "prisma generate",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "db:seed": "npm run build --workspace=@astra/contracts && npm run build && node --env-file-if-exists=.env dist/seed/run.js",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@astra/contracts": "*",
    "@astra/health-engine": "*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-sqlite3": "12.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15"
  }
}
